{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "monumenhi",
  "compatibility_date": "2026-08-15",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/public",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "server/worker.ts"
}
